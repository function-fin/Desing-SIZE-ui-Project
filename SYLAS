RunService.RenderStepped:Connect(function()
    for _, s in ipairs(shapes) do
        if s.Frame and s.Frame.Parent then
            local w = math.floor(s.Frame.AbsoluteSize.X)
            local h = math.floor(s.Frame.AbsoluteSize.Y)

            if s.Type == "Circulo" then
                s.TopTag.Text = w .. " Ø"
                s.BottomTag.Text = tostring(w)
            else
                s.TopTag.Text = w .. " x " .. h
                s.BottomTag.Text = tostring(w)
                s.LeftTag.Text = tostring(h)
            end
        end
    end

    if selectedShape and selectedShape.Frame and selectedShape.Frame.Parent then
        local pos = selectedShape.Frame.AbsolutePosition
        local size = selectedShape.Frame.AbsoluteSize
        local x, y = math.floor(pos.X), math.floor(pos.Y)
        local w, h = math.floor(size.X), math.floor(size.Y)
        local cx, cy = math.floor(x + w / 2), math.floor(y + h / 2)

        local tipoNome = selectedShape.Type == "Circulo" and "Círculo" or (selectedShape.Type == "Retangulo" and "Retângulo" or "Quadrado")

        statsLabel.Text = string.format(
            "Tipo: <b>%s</b>\nPosição: %d, %d\nTamanho: %d, %d\nCentro: %d, %d",
            tipoNome, x, y, w, h, cx, cy
        )
    end
end)
