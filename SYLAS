-- // Utilitários
local function applyCorner(obj, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = obj; return c
end

local function applyStroke(obj, color, t)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(255, 255, 255)
    s.Thickness = t or 1.2
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end

local function round(n)
    return math.floor(n + 0.5)
end

-- // Função de Arraste Robusta
local function makeDraggable(dragHandle, targetFrame)
    local dragging = false
    local dragStartPos = Vector2.new(0, 0)
    local startPos = UDim2.new(0, 0, 0, 0)

    dragHandle.InputBegan:Connect(function(input)
        if dragLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStartPos = input.Position
            startPos = targetFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and not dragLocked then
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStartPos
                targetFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)
end

-- // Função de Coordenadas com Referência de Anchor (Item 5 do Documento)
local function getShapeReference(frame)
    local absPos = frame.AbsolutePosition
    local absSize = frame.AbsoluteSize
    local anchor = frame.AnchorPoint
    
    -- Simulando a extração das bordas do Safe Area
    local topLeftX = absPos.X
    local topLeftY = absPos.Y
    
    -- Cálculo do Centro Geométrico (independente da âncora)
    local centerX = topLeftX + (absSize.X / 2)
    local centerY = topLeftY + (absSize.Y / 2)
    
    -- No futuro, aqui você pode enviar esses dados (Anchor + Offset) para fora
    return topLeftX, topLeftY, absSize.X, absSize.Y, centerX, centerY, anchor
end

local function getTypeName(t)
    if t == "Circulo" then return "Círculo" end
    if t == "Retangulo" then return "Retângulo" end
    return "Quadrado"
end

