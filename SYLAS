-- // SELEÇÃO E LÓGICA DE CLIQUE
-- // ==========================================
local function showHandles(shapeData)
    for _, s in ipairs(shapes) do
        if s.HandlesFolder then
            s.HandlesFolder.Visible = (s == shapeData)
        end
    end
end

local function selectShape(shapeData)
    selectedShape = shapeData
    showHandles(shapeData)
end

local function deselectShape()
    selectedShape = nil
    showHandles(nil)
end

local function toggleShape(shapeData)
    if selectedShape == shapeData then
        deselectShape()
    else
        selectShape(shapeData)
    end
end

local CLICK_THRESHOLD = 6

local function bindFrameInteractions(frame, shapeData)
    local pressPos = nil
    local pressTime = 0
    local dragging = false
    local dragStartPos = nil

    frame.InputBegan:Connect(function(input)
        if dragLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            pressPos = input.Position
            pressTime = tick()
            dragging = false
            dragStartPos = frame.Position

            if selectedShape ~= shapeData then
                selectShape(shapeData)
            end
        end
    end)

    frame.InputChanged:Connect(function(input)
        if dragLocked then return end
        if pressPos and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - pressPos
            if not dragging and delta.Magnitude > CLICK_THRESHOLD then
                dragging = true
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragLocked or not dragging or not pressPos then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - pressPos
            frame.Position = UDim2.new(
                dragStartPos.X.Scale, dragStartPos.X.Offset + delta.X,
                dragStartPos.Y.Scale, dragStartPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if pressPos then
                local held = (tick() - pressTime)
                local moved = dragging
                pressPos = nil
                dragging = false

                if not moved and held < 0.6 then
                    toggleShape(shapeData)
                end
            end
        end
    end)
end

