local function selectShape(shapeData)
    selectedShape = shapeData

    for _, s in ipairs(shapes) do
        if s.HandlesFolder then
            s.HandlesFolder.Visible = (s == shapeData)
        end
    end

    for t, stroke in pairs(toolButtons) do
        if shapeData and t == shapeData.Type then
            stroke.Color = Color3.fromRGB(255, 255, 255)
            stroke.Thickness = 1.8
        else
            stroke.Color = Color3.fromRGB(70, 70, 70)
            stroke.Thickness = 1.2
        end
    end

    if shapeData then
        previewCorner.CornerRadius = (shapeData.Type == "Circulo") and UDim.new(1, 0) or UDim.new(0, 4)
        previewStroke.Thickness = shapeData.Stroke.Thickness
        statusTitle.Text = "Figura Ativa!"
        statusDesc.Text = "Arraste os cantos."
        sizeSliderUpdate(shapeData.Frame.AbsoluteSize.X)
        thickSliderUpdate(shapeData.Stroke.Thickness)
    else
        statusTitle.Text = "Nenhuma Figura"
        statusDesc.Text = "Clique ao lado para criar."
        statsLabel.Text = "Tipo: <b>Nenhum</b>\nPosição: 0, 0\nTamanho: 0, 0\nCentro: 0, 0"
    end
end

local function createShape(shapeType)
    local w, h = currentSize, currentSize
    if shapeType == "Retangulo" then
        w = math.max(120, currentSize)
        h = 45
    elseif shapeType == "Circulo" then
        w = 90
        h = 90
    end

    local frame = Instance.new("Frame")
    frame.Name = "Shape_" .. shapeType
    frame.Size = UDim2.new(0, w, 0, h)
    frame.Position = UDim2.new(0.35, math.random(-20, 20), 0.35, math.random(-20, 20))
    frame.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    frame.Visible = visibilityState[shapeType]
    frame.Parent = shapesLayer

    if shapeType == "Circulo" then
        applyCorner(frame, 999)
    end

    local stroke = applyStroke(frame, Color3.fromRGB(255, 255, 255), currentThickness)

    local topTag = Instance.new("TextLabel")
    topTag.Size = UDim2.new(0, 60, 0, 16)
    topTag.Position = UDim2.new(0.5, -30, 0, -22)
    topTag.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    topTag.TextColor3 = Color3.fromRGB(255, 255, 255)
    topTag.Font = Enum.Font.Code
    topTag.TextSize = 10
    topTag.Parent = frame
    applyCorner(topTag, 4)
    applyStroke(topTag, Color3.fromRGB(255, 255, 255), 1)

    local bottomTag = Instance.new("TextLabel")
    bottomTag.Size = UDim2.new(0, 36, 0, 15)
    bottomTag.Position = UDim2.new(0.5, -18, 1, 6)
    bottomTag.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    bottomTag.TextColor3 = Color3.fromRGB(255, 255, 255)
    bottomTag.Font = Enum.Font.Code
    bottomTag.TextSize = 10
    bottomTag.Parent = frame
    applyCorner(bottomTag, 4)

    local leftTag = Instance.new("TextLabel")
    leftTag.Size = UDim2.new(0, 32, 0, 15)
    leftTag.Position = UDim2.new(0, -40, 0.5, -7.5)
    leftTag.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    leftTag.TextColor3 = Color3.fromRGB(255, 255, 255)
    leftTag.Font = Enum.Font.Code
    leftTag.TextSize = 10
    leftTag.Visible = (shapeType ~= "Circulo")
    leftTag.Parent = frame
    applyCorner(leftTag, 4)

    local handlesFolder = Instance.new("Folder")
    handlesFolder.Name = "ResizeHandles"
    handlesFolder.Parent = frame

    local corners = {
        {name = "TL", x = 0, y = 0, dx = -1, dy = -1},
        {name = "TR", x = 1, y = 0, dx = 1,  dy = -1},
        {name = "BL", x = 0, y = 1, dx = -1, dy = 1},
        {name = "BR", x = 1, y = 1, dx = 1,  dy = 1},
    }

    for _, c in ipairs(corners) do
        local handle = Instance.new("TextButton")
        handle.Size = UDim2.new(0, 10, 0, 10)
        handle.Position = UDim2.new(c.x, -5, c.y, -5)
        handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        handle.Text = ""
        handle.ZIndex = 10
        handle.Parent = handlesFolder
        applyStroke(handle, Color3.fromRGB(0, 0, 0), 1)

        local resizing = false
        local startMouse, startSize, startPos

        handle.InputBegan:Connect(function(input)
            if dragLocked then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                startMouse = input.Position
                startSize = frame.Size
                startPos = frame.Position
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not dragLocked and resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - startMouse
                local newW = math.max(20, startSize.X.Offset + (delta.X * c.dx))
                local newH = math.max(20, startSize.Y.Offset + (delta.Y * c.dy))

                if shapeType == "Circulo" then
                    newH = newW
                end

                local posX = startPos.X.Offset
                local posY = startPos.Y.Offset

                if c.dx == -1 then
                    posX = startPos.X.Offset + (startSize.X.Offset - newW)
                end
                if c.dy == -1 then
                    posY = startPos.Y.Offset + (startSize.Y.Offset - newH)
                end

                frame.Size = UDim2.new(0, newW, 0, newH)
                frame.Position = UDim2.new(startPos.X.Scale, posX, startPos.Y.Scale, posY)
            end
        end)
    end

    local shapeData = {
        Type = shapeType,
        Frame = frame,
        Stroke = stroke,
        TopTag = topTag,
        BottomTag = bottomTag,
        LeftTag = leftTag,
        HandlesFolder = handlesFolder
    }

    makeDraggable(frame, frame, function()
        selectShape(shapeData)
    end)

    table.insert(shapes, shapeData)
    selectShape(shapeData)
end

btnQuadrado.MouseButton1Click:Connect(function() createShape("Quadrado") end)
btnCirculo.MouseButton1Click:Connect(function() createShape("Circulo") end)
btnRetangulo.MouseButton1Click:Connect(function() createShape("Retangulo") end)

